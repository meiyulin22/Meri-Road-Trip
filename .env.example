MOONSHOT_API_KEY=
LLM_MODEL=kimi-k2.6
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
LLM_DEBUG_OUTPUT=false
MERI_TIMEZONE=Asia/Shanghai
# Database. Either a Neon connection string, or the local Docker database:
#   DATABASE_URL="postgresql://meri:meri@localhost:5433/meri"   (run `npm run db:local` first)
# A localhost host selects the node-postgres driver; anything else uses Neon HTTP.
DATABASE_URL="你的 Neon connection string"
BOCHA_API_KEY=
LOG_LEVEL=
# Tianditu, the national map platform: verifies places and suggests them as you type.
TIANDITU_API_KEY=

# Generate plan (planned, not read by the app yet): weather, trains, flights and hotels.
QWEATHER_API_KEY=
QWEATHER_API_HOST=
TUNIU_API_KEY=
ROLLINGGO_API_KEY=

# Place photos: scripts/fetch-place-photos.ts and scripts/build-city-catalog.ts fill public/photos.
# The app also uses it to fill recommendation cards the catalog misses.
PIXABAY_API_KEY=
# Where photos downloaded at run time are kept: outside the release, kept across deploys.
# Required in production for the Pixabay fallback; development defaults to .cache/media.
MERI_MEDIA_DIR=
# Cap on that directory in bytes; at the cap new photos stop being admitted (default 524288000).
MERI_MEDIA_MAX_BYTES=
