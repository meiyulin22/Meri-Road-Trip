# Meri 的环境变量。复制成 .env.local 再填写；.env.local 不进 git。
# 标了「尚未生效」的是已经定好、还没接进代码的变量：先填上也没关系，接入那一步才会读。
# 数字类的上限不填就用注释里的默认值；填的不是正数时也用默认值，并打一条日志。

# ── Kimi（Moonshot）：聊天、规划和 Kimi 联网搜索都用它 ─────────────────────────
MOONSHOT_API_KEY=
# 模型名。K2（kimi-k2.6）十二月底下线，之后用 kimi-k3.1-pro（2026-11-22 起代码已适配：K3 一定会思考，
# 不发 thinking，改发 reasoning_effort，输出上限至少 16000，工具循环带回思考内容）。
LLM_MODEL=kimi-k2.6
# 只对 K3 有效：思考强度 low / high / max。默认 low（Meri 每步都短，思考按输出价计费）；排路线和每天选景点固定用 high。
# LLM_REASONING_EFFORT=low
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# true 时把模型的原始输出写进日志，只在排查问题时打开。
LLM_DEBUG_OUTPUT=false
# 旅程日期按这个时区算。
MERI_TIMEZONE=Asia/Shanghai

# ── 数据库 ─────────────────────────────────────────────────────────────────
# Neon 的连接串，或者本机 Docker 数据库（先运行 `npm run db:local`）：
#   DATABASE_URL="postgresql://meri:meri@localhost:5433/meri"
# 主机是 localhost 时用 node-postgres 驱动，其他都走 Neon HTTP。
DATABASE_URL="你的 Neon connection string"

# ── 博查 Bocha：Workspace 推荐目的地的搜索（找灵感，不当证据）──────────────────────
# 不填也能用：推荐照样生成，只是少了最新网页做参考。Generate plan 默认不用博查。
BOCHA_API_KEY=

# ── 天地图：核验地点、输入提示、景点定位、车程，以及计划页地图（服务器代取瓦片）────
# 这一个服务端 key 就够了；浏览器不再直接用天地图 key（1.2104 起），NEXT_PUBLIC_TIANDITU_BROWSER_KEY 可以删掉。
TIANDITU_API_KEY=

# ── Pixabay：地点照片 ──────────────────────────────────────────────────────
# scripts/fetch-place-photos.ts 和 scripts/build-city-catalog.ts 用它补 public/photos；
# 运行时也用它给图集里没有的推荐卡补图。
PIXABAY_API_KEY=
# 运行时下载的照片放在哪里：要在发布目录之外，跨部署保留。生产环境必填；开发环境默认 .cache/media。
MERI_MEDIA_DIR=
# 这个目录最多占多少字节，到了就不再存新照片。默认 524288000（500 MB）。
MERI_MEDIA_MAX_BYTES=

# ── RollingGo：Generate plan 查酒店（1.2117，只查不订；它的机票接口不接受开发者 key）──
# HOTEL_PROVIDER=rollinggo 加 key 才查；不设就不出「住哪里」。它说免费、不限次数，但写的是「目前阶段免费」、条款链接是空的。
ROLLINGGO_API_KEY=
HOTEL_PROVIDER=
# 北京时间一天最多调用几次（搜索和酒店详情都算），默认 300。
ROLLINGGO_MAX_CALLS_PER_DAY=300

# ── 飞常准 VariFlight：机票，按次付费，预付费，余额为 0 时返回 403，不会欠费 ─────────
# 填 variflight 才查机票；不填就不查，也不花钱。
FLIGHT_PROVIDER=
VARIFLIGHT_API_KEY=
# 一次 Generate plan 最多在飞常准花多少钱，单位元，可写小数。查价、中转城市查询每次 ¥0.25，转机一次 ¥0.50。默认 2。
VARIFLIGHT_MAX_YUAN_PER_PLAN=2
# 每天（北京时间）全站最多在飞常准花多少钱。到了打一条日志，航班停到北京时间 0 点。默认 20。
VARIFLIGHT_MAX_YUAN_PER_DAY=20

# ── 火车：只查不订（2026-11-22 起默认走飞常准 Tripmatch searchTrainTickets，¥0.25/次）──────
# 不填或填 variflight：用飞常准（要 VARIFLIGHT_API_KEY，花的钱算进 VARIFLIGHT_MAX_YUAN_PER_DAY）；
# 填 12306：开发用的 12306-mcp（免费、非官方、不稳定）；填 off：不查火车。
RAIL_PROVIDER=
# 一次 Generate plan 最多查几次火车（中转一次算两次）。默认 8，走飞常准时最多 ¥2。
RAIL_MAX_SEARCHES_PER_PLAN=8
# 每天全站最多向 12306 发多少个请求。到了打一条日志，火车停到北京时间 0 点。默认 100。
RAIL_MAX_REQUESTS_PER_DAY=100

# ── 搜索的上限和顺序（1.2113 第 1 步起生效）───────────────────────────────────────
# Generate plan 用哪家搜索：kimi = 调研和核实都用 Kimi（默认，2026-10-29 实测关键的闭园、限流只有 Kimi 找到）；
# bocha = 先用博查省钱（一次规划约省 ¥0.34），Agent 觉得信息不够或博查到了上限再用 Kimi 补。
PLAN_SEARCH_PROVIDER=kimi
# 博查每天全站最多调用多少次（规划和 Workspace 推荐都算）。到了打一条日志，改用 Kimi 搜索。默认 500。
BOCHA_MAX_CALLS_PER_DAY=500
# Kimi 联网搜索每天全站最多多少次（实测一次规划 5–14 次，每天最多 30 次规划；¥0.015/次，450 次约 ¥6.8）。
# 要跟着规划次数走：搜索先用完，规划质量就会变差。到了打一条日志，搜索停到北京时间 0 点。默认 450。
KIMI_MAX_SEARCHES_PER_DAY=450

# ── 全站上限和总开关（第 2 步起生效）──────────────────────────────────────────
# 总开关：false 时在发请求前停掉所有付费调用（Kimi 模型、Kimi 搜索、博查、飞常准），聊天和计划页提示「演示暂停中」。
# 发现异常先关它，改完重启。默认 true。
PAID_CALLS_ENABLED=true
# 全站每天（北京时间）最多新开几次 Generate plan，按数据库里当天新建的规划条数算；刷新看已有计划、回答问题后继续都不算。
# 到了计划页提示「今天的演示规划次数用完了」。默认 30（¥40 的 Kimi 额度够 50 次以上）。
PLAN_RUNS_PER_DAY=30
# Kimi 模型每天全站最多花多少钱（元），聊天和规划都算。代码按每次返回的 token（输入、输出、缓存命中）和模型价格表估算，
# 记在 .cache/kimi-spend.json；这是拦截用的估算，真实账单以 Moonshot 控制台为准。到了打一条日志，页面提示额度用完。默认 40。
KIMI_MAX_YUAN_PER_DAY=40

# ── 每位访客、每个 IP 的上限（第 3 步起生效，记在内存里，重启清零，IP 不写进数据库）───────────
# 每位访客（cookie）每天（北京时间）最多新开几次 Generate plan，按数据库数；我们自己出错导致的失败不算。默认 3。
PLAN_RUNS_PER_GUEST_PER_DAY=3
# 同一个 IP 24 小时内最多新开几次 Generate plan，清 cookie 也绕不过；失败的不算。设高一点，照顾同公司共用 IP 的面试官。默认 6。
PLAN_RUNS_PER_IP_PER_DAY=6
# 每位访客每小时最多发几句聊天（每句都调用 Kimi）。到了聊天里提示「这一小时发得有点多」。默认 30。
CHAT_TURNS_PER_GUEST_PER_HOUR=30
# 同一个 IP 每小时最多调用几次 Kimi，所有调用 Kimi 的接口都算（聊天、新建旅程、推荐、偏好、Generate plan……），到了回 429。默认 120。
# IP 只认我们自己的代理写的请求头：x-real-ip，其次 x-forwarded-for 的最后一个；部署时 nginx/Caddy 要覆盖写 x-real-ip。
KIMI_REQUESTS_PER_IP_PER_HOUR=120
# Open-Meteo 天气（1.2117，免费、无 key、非商用）：北京时间一天最多算几次调用（一个坐标点算一次，超过两周的日期范围按两次算）。
# 它的免费额度是每个 IP 每天 10,000 次；默认 2000，远低于它。
OPEN_METEO_MAX_CALLS_PER_DAY=2000
# MET Norway 天气（2026-11-21，Open-Meteo 查不到时的替补；免费、无 key、CC BY 4.0）：北京时间一天最多几次调用，一个坐标点一次。默认 1000。
MET_NORWAY_MAX_CALLS_PER_DAY=1000
# MET Norway 要求 User-Agent 写明应用（最好带网站或联系方式）；不填用 "Meri/1.2117 personal non-commercial travel planner"。不要写个人邮箱。
# MET_NORWAY_USER_AGENT=


# ── 其他 ───────────────────────────────────────────────────────────────────
# 日志级别（debug、info、warn、error）。不填时开发环境用 debug，生产环境用 info。
LOG_LEVEL=
# 以后的天气和途牛火车，尚未生效。
QWEATHER_API_KEY=
QWEATHER_API_HOST=
TUNIU_API_KEY=
